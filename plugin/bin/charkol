#!/bin/sh
set -eu

plugin_root=$(cd "$(dirname "$0")/.." && pwd)
desktop_app=/Applications/Charkol.app
app_folder="$HOME/Library/Application Support/com.coconutestates.Charkol"
download_site=https://download.charkol.ai
runtime_zip=charkol-runtime-macos-arm64.zip
signed_by_charkol='anchor apple generic and certificate leaf[subject.OU] = "2NC533SE3E"'

if [ -f "$plugin_root/channel" ]; then
  CHARKOL_CHANNEL=$(cat "$plugin_root/channel")
  export CHARKOL_CHANNEL
  app_folder="$app_folder.$CHARKOL_CHANNEL"
  download_site="https://download.$CHARKOL_CHANNEL.charkol.ai"
  case "$CHARKOL_CHANNEL" in
    dev) desktop_app="/Applications/Charkol Dev.app" ;;
  esac
fi
desktop_app="${CHARKOL_DESKTOP_APP:-$desktop_app}"
download_site="${CHARKOL_DOWNLOAD_URL:-$download_site}"

runtimes="$app_folder/runtime"
required_version=$(cat "$plugin_root/runtime-version" 2>/dev/null || true)

installed_version() {
  version=$(cat "$runtimes/current" 2>/dev/null || true)
  [ -n "$version" ] && [ -x "$runtimes/$version/charkol" ] && printf '%s\n' "$version"
}

older_than_required() {
  [ -n "$required_version" ] && [ "$1" != "$required_version" ] && [ "$(printf '%s\n%s\n' "$1" "$required_version" | sort -V | head -1)" = "$1" ]
}

signed_by_charkol() {
  codesign --verify --strict -R="$signed_by_charkol" "$1/charkol" 2>/dev/null && codesign --verify --strict -R="$signed_by_charkol" "$1/charkol-bridge" 2>/dev/null
}

install_latest() {
  mkdir -p "$runtimes"
  latest=$(curl -fsL "$download_site/latest" | tr -d '[:space:]')
  staging=$(mktemp -d "$runtimes/download.XXXXXX")
  if [ -z "$latest" ] || ! curl -fsL "$download_site/$latest/$runtime_zip" -o "$staging/$runtime_zip" || ! ditto -x -k "$staging/$runtime_zip" "$staging/$latest"; then
    echo "Couldn't download Charkol from $download_site. Check your connection and try again." >&2
  elif ! signed_by_charkol "$staging/$latest"; then
    echo "The Charkol download from $download_site isn't signed by Charkol, so it wasn't installed." >&2
  elif [ ! -e "$runtimes/$latest" ]; then
    mv "$staging/$latest" "$runtimes/$latest"
  fi
  rm -rf "$staging"
  [ -n "$latest" ] && signed_by_charkol "$runtimes/$latest" || return 1
  printf '%s\n' "$latest" > "$runtimes/current"
}

if [ -x "$desktop_app/Contents/MacOS/charkol" ]; then
  runtime="$desktop_app/Contents/MacOS"
else
  version=$(installed_version || true)
  if [ -z "$version" ] || older_than_required "$version"; then
    if [ "${1:-}" = hook ]; then
      exit 0
    fi
    if install_latest; then
      version=$(installed_version)
    elif [ -z "$version" ]; then
      exit 1
    fi
  fi
  runtime="$runtimes/$version"
fi

CHARKOL_LAUNCHER="$plugin_root/bin/$(basename "$0")"
export CHARKOL_LAUNCHER

case "${1:-}" in
  tasks) exec "$runtime/charkol-bridge" "$@" ;;
  watch) exec "$runtime/charkol-bridge" watch ;;
  hook) exec "$runtime/charkol-bridge" hook ;;
  mcp) exec "$runtime/charkol-bridge" ;;
  *) exec "$runtime/charkol" "$@" ;;
esac
